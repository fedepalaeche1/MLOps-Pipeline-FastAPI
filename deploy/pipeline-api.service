[Unit]
Description=API FastAPI - Pipeline de aprobacion de credito (MLOps EIA)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/MLOps-Pipeline-FastAPI
Environment="PATH=/home/ubuntu/MLOps-Pipeline-FastAPI/.venv/bin"
ExecStart=/home/ubuntu/MLOps-Pipeline-FastAPI/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
